{
  "manifest_version": 3,
  "name": "iCampus Checker - SKKU",
  "description": "성균관대학교 iCampus의 강의와 과제 일정을 효율적으로 관리하는 도구",
  "version": "1.0.0",

  "browser_specific_settings": {
    "gecko": {
      "id": "sjssjs1344@gmail.com",
      "strict_min_version": "109.0"
    }
  },

  "content_scripts": [
    {
      "matches": ["*://canvas.skku.edu/*"],
      "js": ["content.js"]
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html",
    "default_title": "iCampus Checker"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["utils.js"],
      "matches": ["*://canvas.skku.edu/*"]
    }
  ],

  "host_permissions": ["*://canvas.skku.edu/*"],
  "permissions": ["scripting", "tabs", "storage"]
}
